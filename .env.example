# ============================================================
# Internship Task Review Assistant - Environment Configuration
# ============================================================

# Gemini AI API Configuration
# Optional: If not provided, the application will automatically run in
# a clearly-labelled Rule-Based Demo Fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SMTP Email Configuration
# Optional: If not configured, all feedback emails will be safely
# previewed and recorded as SIMULATED — NOT SENT.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reviewer@example.com
SMTP_USE_TLS=true

# Application Settings
APP_ENV=development
DATABASE_PATH=data/assistant.db
UPLOAD_DIR=uploads
