# ============================================================
# Internship Task Review Assistant - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Google Gemini Configuration (Primary & Optional Secondary)
# ------------------------------------------------------------
# If omitted, the app operates in Offline Mode using verified local datasets.
# Secret files supported: .env/api_key.txt or mounted secret directories.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional secondary key for automatic failover
GEMINI_API_KEY_2=

# ------------------------------------------------------------
# OpenAI Configuration (Optional failover provider)
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# SMTP Email Configuration
# ------------------------------------------------------------
# If omitted or inactive, reviews record 'SIMULATED — NOT SENT'.
# Secret files supported: .env/email.txt
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_ENV=development
DATABASE_PATH=data/assistant.db
UPLOAD_DIR=uploads
